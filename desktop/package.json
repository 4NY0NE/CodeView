{
  "name": "codeview-desktop",
  "version": "0.1.1",
  "private": true,
  "description": "CodeView para Windows: transmissão de tela com som por aplicativo",
  "main": "main.js",
  "author": "CodeView",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never"
  },
  "dependencies": {
    "application-loopback": "1.2.7"
  },
  "devDependencies": {
    "electron": "45.3.0",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "app.codeview.desktop",
    "productName": "CodeView",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": ["main.js", "preload.js", "audiowatch.js", "package.json"],
    "asarUnpack": ["node_modules/application-loopback/bin/**"],
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "icon": "build/icon.png",
      "artifactName": "CodeView-Setup-${version}.${ext}"
    },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "perMachine": false }
  }
}
